{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    "import/no-unassigned-import": "off",
    "eqeqeq": ["error", "always"],
    "no-console": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/consistent-type-imports": "warn",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unsafe-type-assertion": "off"
  },
  "overrides": [
    {
      "files": [
        "src/**/*.state.ts",
        "src/**/*.value.ts",
        "src/**/*.core.ts",
        "src/**/*.content.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@prisma/*",
                  "fastify",
                  "graphql",
                  "graphql-yoga",
                  "@pothos/*",
                  "**/builder*",
                  "**/prisma*",
                  "**/db*",
                  "**/uow*",
                  "**/locks*",
                  "**/lock-registry*",
                  "**/flags*",
                  "**/flag-registry*",
                  "**/flag-reader*",
                  "**/*.repo*",
                  "**/*.service*"
                ],
                "message": "Pure modules (*.state.ts / *.value.ts / *.core.ts / *.content.ts) must stay free of I/O, transactions, and framework deps. Decide here; read, lock, and execute in the repo/service shell. A core receives a flag value as passed-in DATA (see point.transfer) — it never reads a flag itself."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/db/locks.ts", "src/db/lock-registry.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@prisma/*",
                  "fastify",
                  "graphql",
                  "graphql-yoga",
                  "@pothos/*",
                  "**/builder*",
                  "**/prisma*",
                  "**/db*",
                  "**/uow*",
                  "**/*.repo*",
                  "**/*.service*"
                ],
                "message": "The advisory-lock key policy (locks.ts machinery + lock-registry.ts) must stay pure: no I/O, transactions, or framework deps. The two may reference each other (registry → machinery), but nothing in the repo/service/db shell."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/flags/flags.ts", "src/flags/flag-registry.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@prisma/*",
                  "fastify",
                  "graphql",
                  "graphql-yoga",
                  "@pothos/*",
                  "@openfeature/*",
                  "**/builder*",
                  "**/prisma*",
                  "**/db*",
                  "**/uow*",
                  "**/locks*",
                  "**/lock-registry*",
                  "**/flag-reader*",
                  "**/*.repo*",
                  "**/*.service*"
                ],
                "message": "The feature-flag catalog (flags.ts machinery + flag-registry.ts) must stay pure: no I/O, no OpenFeature SDK, no framework deps. The registry may import the machinery (flag-registry → flags); binding to a client lives in flag-reader.ts (the uow.ts analogue), the one facade file that imports the SDK."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/modules/**/*.provider.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "graphql",
                  "graphql-yoga",
                  "@pothos/*",
                  "**/builder*",
                  "fastify",
                  "**/uow*",
                  "**/locks*",
                  "**/lock-registry*",
                  "**/flags*",
                  "**/flag-registry*",
                  "**/flag-reader*",
                  "**/*.service*"
                ],
                "message": "A provider (*.provider.ts) is an external-port adapter: it may read via db + a repo and speak its SDK, but it must not know the schema, the transport, transactions, a service, or the flag facade — it sits BELOW the flag reader (which delegates to it), never reaching up into it. The DB feature-flag provider reads the FeatureFlag rows and decides with the pure core predicate."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/modules/**/*.service.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["graphql", "graphql-yoga", "@pothos/*", "**/builder*", "fastify", "@openfeature/*", "**/flag-reader*"],
                "message": "Use-cases (*.service.ts) speak the domain language only: no GraphQL/transport imports, and no OpenFeature SDK or flag-reader factory. A service receives the FlagReader as a per-call argument (the FlagReader TYPE from flag-registry is fine — like importing uow / lock-registry types); the schema layer or context factory builds the reader. The schema layer calls the service, never the other way round."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/modules/**/*.repo.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "graphql",
                  "graphql-yoga",
                  "@pothos/*",
                  "**/builder*",
                  "fastify",
                  "**/uow*",
                  "**/locks*",
                  "**/lock-registry*",
                  "**/flags*",
                  "**/flag-registry*",
                  "**/flag-reader*"
                ],
                "message": "The persistence layer (*.repo.ts) must not know the schema, the transport, transactions, or feature flags. It receives a DbClient (rw/ro/tx — the caller's choice, who also opens the transaction and takes the locks) and returns rows."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/modules/**/*.schema.ts", "src/**/modules/**/schemas/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["fastify", "**/prisma.js", "**/db.js", "**/uow*", "**/locks*", "**/lock-registry*", "**/flags*", "**/flag-registry*", "**/flag-reader*", "@openfeature/*"],
                "message": "Schema files resolve through ctx (the routed selection client + services + ctx.flags) and repo read functions — they never construct or import database handles, open transactions, take locks, or build a flag reader (that is the service's / context factory's job). Gate exposure with ctx.flags."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/modules/**/*.route.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@pothos/*",
                  "graphql",
                  "graphql-yoga",
                  "**/builder*",
                  "**/prisma.js",
                  "**/db.js",
                  "**/uow*",
                  "**/locks*",
                  "**/lock-registry*"
                ],
                "message": "Route files are the HTTP delivery layer (the peer of schemas/): they register on Fastify and receive their service at registration time, so they never import the GraphQL builder, the database handles, transactions, or locks — the service owns those."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/graphql/builder.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/modules/**"],
                "message": "builder.ts must not import feature modules (modules import the builder). Importing them here would create an import cycle."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/tests/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "src/generated/**",
    "prisma/migrations/**",
    "coverage/**"
  ]
}
