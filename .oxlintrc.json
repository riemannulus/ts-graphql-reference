{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    "import/no-unassigned-import": "off",
    "eqeqeq": ["error", "always"],
    "no-console": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/consistent-type-imports": "warn",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unsafe-type-assertion": "off"
  },
  "overrides": [
    {
      "files": [
        "src/**/*.state.ts",
        "src/**/*.value.ts",
        "src/**/*.core.ts",
        "src/**/*.content.ts",
        "src/db/locks.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@prisma/*",
                  "fastify",
                  "graphql",
                  "graphql-yoga",
                  "@pothos/*",
                  "**/builder*",
                  "**/prisma*",
                  "**/db*",
                  "**/uow*",
                  "**/locks*",
                  "**/*.repo*",
                  "**/*.service*"
                ],
                "message": "Pure modules (*.state.ts / *.value.ts / *.core.ts / *.content.ts, and locks.ts) must stay free of I/O, transactions, and framework deps. Decide here; read, lock, and execute in the repo/service shell."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/modules/**/*.service.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["graphql", "graphql-yoga", "@pothos/*", "**/builder*", "fastify"],
                "message": "Use-cases (*.service.ts) speak the domain language only: no GraphQL/transport imports. The schema layer calls the service, never the other way round."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/modules/**/*.repo.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "graphql",
                  "graphql-yoga",
                  "@pothos/*",
                  "**/builder*",
                  "fastify",
                  "**/uow*",
                  "**/locks*"
                ],
                "message": "The persistence layer (*.repo.ts) must not know the schema, the transport, or transactions. It receives a DbClient (rw/ro/tx — the caller's choice, who also opens the transaction and takes the locks) and returns rows."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/modules/**/*.schema.ts", "src/**/modules/**/schemas/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["fastify", "**/prisma.js", "**/db.js", "**/uow*", "**/locks*"],
                "message": "Schema files resolve through ctx (the routed selection client + services) and repo read functions — they never construct or import database handles, open transactions, or take locks (that is the service's job)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/modules/**/*.route.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@pothos/*",
                  "graphql",
                  "graphql-yoga",
                  "**/builder*",
                  "**/prisma.js",
                  "**/db.js",
                  "**/uow*",
                  "**/locks*"
                ],
                "message": "Route files are the HTTP delivery layer (the peer of schemas/): they register on Fastify and receive their service at registration time, so they never import the GraphQL builder, the database handles, transactions, or locks — the service owns those."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/graphql/builder.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/modules/**"],
                "message": "builder.ts must not import feature modules (modules import the builder). Importing them here would create an import cycle."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/tests/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "src/generated/**",
    "prisma/migrations/**",
    "coverage/**"
  ]
}
