# PostgreSQL connection, used by both the Prisma CLI (migrate/studio) and the
# running server (the PRIMARY / read-write handle). Start a local dev database
# with, e.g.:
#   docker run -d -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=app -p 5432:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"

# Optional read replica for the query path (see README "RWDB / RODB routing").
# Leave unset to route all reads to the primary.
# READONLY_DATABASE_URL="postgresql://postgres:postgres@replica-host:5432/app"

# HTTP port for the Fastify server
PORT=4000

# ── Observability ────────────────────────────────────────────────────────────
# All optional: unset, the app logs to stdout and serves Prometheus metrics, but
# exports no traces — it runs on Postgres alone. See README "Observability".

# pino log level: fatal | error | warn | info | debug | trace | silent.
# Unknown/unset → info. GraphQL variables are logged only at `debug` (redacted).
# LOG_LEVEL=info

# OTLP endpoint for TRACES. Unset → spans are no-ops (zero overhead). Point it at
# a collector to see traces; docker-compose.observability.yml runs one locally:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logical service name / deploy stage attached to every span & metric.
# OTEL_SERVICE_NAME=gannet
# STAGE=local

# Prometheus scrape endpoint is served on its OWN port (never the public API
# port, never an obscure path). Disable with METRICS_ENABLED=false.
# METRICS_ENABLED=true
# METRICS_PORT=9464

# ── Sentry (optional) ────────────────────────────────────────────────────────
# ERRORS (app-side @sentry/node): set SENTRY_DSN to turn Sentry error tracking
# on. Unset → the SDK stays inert and errors just go to the OTel span/logs. The
# app runs Sentry error-only (it does NOT own tracing — that stays OTel's).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=local
# SENTRY_RELEASE=

# TRACES (collector-side, NOT read by the app): to also ship traces to Sentry,
# uncomment the otlphttp/sentry exporter in observability/otel-collector-config.yaml
# and set these (passed to the collector by docker-compose.observability.yml).
# Copy BOTH verbatim from Sentry: Project Settings → Client Keys (DSN) →
# OpenTelemetry (OTLP) — the exact traces URL (its path may include a region
# and/or an `/integration` segment) and the ready-made auth. The public key is
# the part BEFORE '@' in the DSN — not the whole DSN.
# SENTRY_OTLP_TRACES_ENDPOINT=   # e.g. https://oORG.ingest.sentry.io/api/PROJECT/otlp/v1/traces
# SENTRY_OTLP_PUBLIC_KEY=
#
# METRICS → Sentry: not supported (Sentry ingests OTLP traces + logs only).
# Keep metrics in Prometheus; correlate to Sentry via the trace_id.
