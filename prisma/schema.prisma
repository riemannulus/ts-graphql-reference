// Prisma schema — https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider     = "prisma-pothos-types"
  // Emit a .ts file (not the default type-only .d.ts) so it includes the
  // runtime getDatamodel() that Pothos requires on Prisma 7.
  output       = "../src/generated/pothos-types.ts"
  clientOutput = "@prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum TransactionFlowKind {
  COMMISSION
}

enum FinancialCommandKind {
  PAY
  EXTRA_PAY
  SETTLE
  REFUND
  CANCEL
}

/// A user of the system. `status` is a state machine (see user.state.ts):
/// ACTIVE | SUSPENDED | DEACTIVATED. The *transition rules* live in code (the
/// single source of truth, user.state.ts); the *value set* is additionally
/// enforced by a DB CHECK constraint (see the migrations), so a corrupt write
/// fails at the database instead of surfacing later as a bad read.
model User {
  id                      Int                   @id @default(autoincrement())
  email                   String                @unique
  name                    String?
  status                  String                @default("ACTIVE")
  posts                   Post[]
  pointBalance            PointBalance?
  pointCharges            PointCharge[]
  pointSpends             PointSpend[]
  commissionTypesAsWorker CommissionType[]      @relation("CommissionTypeWorker")
  commissionSlotsAsWorker CommissionSlot[]      @relation("CommissionSlotWorker")
  ordersAsBuyer           Order[]               @relation("OrderBuyer")
  contractsAsBuyer        Contract[]            @relation("ContractBuyer")
  contractsAsWorker       Contract[]            @relation("ContractWorker")
  financialCommands       FinancialCommandRun[]
  createdAt               DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @db.Timestamptz(6)
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  published Boolean  @default(false)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([authorId])
}

/// Denormalized point balance per user — the snapshot the spend use-case
/// decides against. Kept consistent with the charge ledger inside the same
/// transaction that mutates it (see point.repo.ts).
model PointBalance {
  userId      Int      @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidAmount  Int      @default(0)
  freeAmount  Int      @default(0)
  totalAmount Int      @default(0)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
}

/// One charge (top-up) of points. `state` is USABLE | CONSUMED | EXPIRED,
/// enforced by a DB CHECK constraint; the unspent columns carry non-negative
/// CHECKs so an overdraft can never be persisted even by buggy application code.
/// A charge EXPIRES at the end of the KST day `EXPIRE_AFTER_DAYS` after
/// `chargedAt` (the rule lives in point.core.ts `planExpiry`); `expiredAt` is
/// stamped by that decision (the plan's `now`), never a DB default — see
/// CONVENTIONS §10 "Time".
model PointCharge {
  id                Int       @id @default(autoincrement())
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  state             String    @default("USABLE")
  paidAmount        Int
  freeAmount        Int
  unspentPaidAmount Int
  unspentFreeAmount Int
  /// When the charge happened. Stamped by the charge use-case from the app clock
  /// (planCharge carries it) because the expiry decision reads it back against
  /// `now` — CONVENTIONS §10. `@default(now())` stays only as a backstop for a
  /// raw insert that bypasses the use-case.
  chargedAt         DateTime  @default(now()) @db.Timestamptz(6)
  /// When this charge was expired (its remainder swept to zero); NULL until then.
  /// A domain timestamp, written by the expiry use-case, not `@default(now())`.
  expiredAt         DateTime? @db.Timestamptz(6)

  @@index([userId, state, chargedAt])
}

/// A feature flag — the crepe model: a flag is ACTIVE only for a specific deploy
/// `stage`, inside its `[enableAfter, disableAfter]` window, and while not
/// soft-deleted. `name` is the OpenFeature flag key; the DB-backed OpenFeature
/// provider (src/modules/feature-flag/feature-flag.provider.ts) reads the one
/// LIVE row per name. The activation rule lives in code (feature-flag.core.ts
/// `isActive`, single source of truth); the `stage` value set and the window
/// ordering are additionally backed by DB CHECK constraints (see the migration),
/// and one-live-row-per-name by a partial unique index — so a name is reusable
/// after a soft delete (crepe recreate-by-name).
model FeatureFlag {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  /// Deploy environment this flag applies to (value set backed by a CHECK, like
  /// User.status — never a Prisma enum). A NULL-stage row can never be active.
  stage        String?
  /// Optional payload for a non-boolean flag: the variant/value an ACTIVE flag
  /// resolves to (e.g. the welcome-post variant). NULL for a plain on/off gate.
  /// This extends the crepe model, which is boolean-only, so the DB provider can
  /// back OpenFeature string/variant resolution over the same table.
  value        String?
  enableAfter  DateTime? @db.Timestamptz(6)
  disableAfter DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  @@index([name])
}

/// One spend of points, recording how it split across paid and free balance.
model PointSpend {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidAmount  Int
  freeAmount  Int
  totalAmount Int
  reason      String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
}

/// PROTOTYPE — a purchasable commission offering. A completed initial payment
/// forms one Contract; prepayment state belongs to Order.
model CommissionType {
  id       Int     @id @default(autoincrement())
  workerId Int
  worker   User    @relation("CommissionTypeWorker", fields: [workerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  title    String
  price    Int
  orders   Order[]

  @@index([workerId])
}

/// PROTOTYPE — capacity reserved by an Order and occupied when commission checkout commits.
model CommissionSlot {
  id       Int    @id @default(autoincrement())
  workerId Int
  worker   User   @relation("CommissionSlotWorker", fields: [workerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  state    String @default("AVAILABLE")
  order    Order?

  @@index([workerId, state])
}

/// PROTOTYPE — owns all facts that exist before a commission/Contract forms.
model Order {
  id               Int             @id @default(autoincrement())
  buyerId          Int
  buyer            User            @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  commissionTypeId Int
  commissionType   CommissionType  @relation(fields: [commissionTypeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  slotId           Int             @unique
  slot             CommissionSlot  @relation(fields: [slotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  flowId           String          @unique @db.Uuid
  flow             TransactionFlow @relation(fields: [flowId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  titleSnapshot    String
  amount           Int
  currency         String          @default("POINT")
  state            String          @default("REQUESTED")
  payments         OrderPayment[]
  contract         Contract?
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([id, flowId])
  @@index([buyerId, state])
  @@index([commissionTypeId])
}

/// PROTOTYPE — one immutable initial-payment request owned by Order.
model OrderPayment {
  id                Int                 @id @default(autoincrement())
  orderId           Int
  flowId            String              @db.Uuid
  order             Order               @relation(fields: [orderId, flowId], references: [id, flowId], onDelete: Restrict, onUpdate: NoAction)
  amount            Int
  currency          String              @default("POINT")
  state             String              @default("PENDING")
  financialLink     OrderFinancialLink?
  /// Deprecated physical column from the preceding unshipped PoC migration.
  /// Public references come from Order.flow(kind + UUID).
  legacyReferenceId String?             @unique @map("referenceId")
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([id, flowId])
  @@index([orderId, state])
}

/// PROTOTYPE — finance-owned principal identified by an opaque external binding.
model FinancialHolder {
  id               Int                    @id @default(autoincrement())
  bindingNamespace String
  bindingKey       String
  accounts         FinancialAccount[]
  reservations     FinancialReservation[]

  @@unique([bindingNamespace, bindingKey])
}

/// PROTOTYPE — generic hold. It intentionally has no product-domain foreign key.
model FinancialReservation {
  id                Int                 @id @default(autoincrement())
  flowId            String              @db.Uuid
  flow              TransactionFlow     @relation(fields: [flowId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  /// Deprecated storage; new writes leave it NULL and use flowId.
  legacyReferenceId String?             @unique @map("referenceId")
  bindingNamespace  String
  bindingKey        String
  holderId          Int
  holder            FinancialHolder     @relation(fields: [holderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  purpose           String
  currency          String
  targetAmount      Int
  state             String              @default("HELD")
  escrowAccount     FinancialAccount?
  transfer          FinancialTransfer?
  orderLink         OrderFinancialLink?
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)

  @@unique([bindingNamespace, bindingKey])
  @@unique([id, flowId])
  @@index([holderId, state])
}

/// PROTOTYPE — AVAILABLE belongs to a holder; ESCROW belongs to a reservation.
model FinancialAccount {
  id            Int                   @id @default(autoincrement())
  currency      String
  purpose       String
  holderId      Int?
  holder        FinancialHolder?      @relation(fields: [holderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reservationId Int?                  @unique
  reservation   FinancialReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lots          PointLot[]
  outgoing      FinancialTransfer[]   @relation("FinancialTransferFrom")
  incoming      FinancialTransfer[]   @relation("FinancialTransferTo")

  @@unique([holderId, currency, purpose])
}

/// PROTOTYPE — POINT provenance and remaining spendable amount.
model PointLot {
  id              Int                           @id @default(autoincrement())
  accountId       Int
  account         FinancialAccount              @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceKind      String
  originalAmount  Int
  remainingAmount Int
  allocations     FinancialTransferAllocation[]
  createdAt       DateTime                      @default(now()) @db.Timestamptz(6)

  @@index([accountId, createdAt, id])
}

/// PROTOTYPE — append-only transfer from AVAILABLE to reservation ESCROW.
model FinancialTransfer {
  id            Int                           @id @default(autoincrement())
  reservationId Int                           @unique
  flowId        String                        @db.Uuid
  reservation   FinancialReservation          @relation(fields: [reservationId, flowId], references: [id, flowId], onDelete: Restrict, onUpdate: NoAction)
  fromAccountId Int
  fromAccount   FinancialAccount              @relation("FinancialTransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  toAccountId   Int
  toAccount     FinancialAccount              @relation("FinancialTransferTo", fields: [toAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  amount        Int
  actionId      String                        @unique @db.Uuid
  action        FinancialTransferAction       @relation(fields: [actionId, flowId], references: [id, flowId], onDelete: Restrict, onUpdate: NoAction)
  allocations   FinancialTransferAllocation[]
  createdAt     DateTime                      @default(now()) @db.Timestamptz(6)

  @@unique([reservationId, flowId])
  @@unique([actionId, flowId])
}

model FinancialTransferAllocation {
  transferId Int
  transfer   FinancialTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lotId      Int
  lot        PointLot          @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  amount     Int

  @@id([transferId, lotId])
}

/// PROTOTYPE — product-owned mapping; its FK points into finance, never back.
model OrderFinancialLink {
  orderPaymentId Int                  @id
  flowId         String               @db.Uuid
  orderPayment   OrderPayment         @relation(fields: [orderPaymentId, flowId], references: [id, flowId], onDelete: Restrict, onUpdate: NoAction)
  reservationId  Int                  @unique
  reservation    FinancialReservation @relation(fields: [reservationId, flowId], references: [id, flowId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([orderPaymentId, flowId])
  @@unique([reservationId, flowId])
}

/// PROTOTYPE — a formed commission. There is no Contract before commission checkout.
model Contract {
  id       Int      @id @default(autoincrement())
  orderId  Int      @unique
  flowId   String   @db.Uuid
  order    Order    @relation(fields: [orderId, flowId], references: [id, flowId], onDelete: Restrict, onUpdate: NoAction)
  buyerId  Int
  buyer    User     @relation("ContractBuyer", fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  workerId Int
  worker   User     @relation("ContractWorker", fields: [workerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  formedAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([orderId, flowId])
  @@index([buyerId])
  @@index([workerId])
}

/// PROTOTYPE — the business transaction spine. Public references are derived
/// from kind + opaque id, so their prefix cannot disagree with persisted data.
model TransactionFlow {
  id           String                 @id @default(uuid()) @db.Uuid
  kind         TransactionFlowKind
  orders       Order[]
  reservations FinancialReservation[]
  commands     FinancialCommandRun[]
  policies     FlowCommandPolicy[]
  createdAt    DateTime               @default(now()) @db.Timestamptz(6)

  @@unique([id, kind])
}

/// Explicit allow-list owned by each flow instance. A new flow family cannot
/// accept a command until its creator records that command kind here.
model FlowCommandPolicy {
  flowId      String                @db.Uuid
  commandKind FinancialCommandKind
  flow        TransactionFlow       @relation(fields: [flowId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  commands    FinancialCommandRun[]

  @@id([flowId, commandKind])
}

/// One idempotent command attempt. A second key may point at an existing
/// operation, but the composite FK still requires the same flow and kind.
model FinancialCommandRun {
  id                  String               @id @default(uuid()) @db.Uuid
  flowId              String               @db.Uuid
  flowKind            TransactionFlowKind
  kind                FinancialCommandKind
  principalId         Int
  principal           User                 @relation(fields: [principalId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  idempotencyKey      String
  payloadHash         String
  subjectNamespace    String
  subjectKey          String
  resultOperationId   String?              @db.Uuid
  flow                TransactionFlow      @relation(fields: [flowId, flowKind], references: [id, kind], onDelete: Restrict, onUpdate: NoAction)
  policy              FlowCommandPolicy    @relation(fields: [flowId, kind], references: [flowId, commandKind], onDelete: Restrict, onUpdate: NoAction)
  originatedOperation FinancialOperation?  @relation("OriginatingCommand")
  resultOperation     FinancialOperation?  @relation("CommandResult", fields: [resultOperationId, flowId, kind], references: [id, flowId, kind], onDelete: Restrict, onUpdate: NoAction)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)

  @@unique([principalId, kind, idempotencyKey])
  @@unique([id, flowId, kind])
  @@index([subjectNamespace, subjectKey, kind, createdAt])
}

/// One committed financial operation. Its composite FK guarantees that it has
/// the same flow and kind as the command that originated it.
model FinancialOperation {
  id                   String                    @id @default(uuid()) @db.Uuid
  flowId               String                    @db.Uuid
  kind                 FinancialCommandKind
  originatingCommandId String                    @unique @db.Uuid
  originatingCommand   FinancialCommandRun       @relation("OriginatingCommand", fields: [originatingCommandId, flowId, kind], references: [id, flowId, kind], onDelete: Restrict, onUpdate: NoAction)
  resultCommands       FinancialCommandRun[]     @relation("CommandResult")
  transferActions      FinancialTransferAction[]
  postedAt             DateTime                  @default(now()) @db.Timestamptz(6)

  @@unique([id, flowId, kind])
  @@unique([id, flowId])
  @@unique([originatingCommandId, flowId, kind])
}

/// A structurally typed TRANSFER effect. Other action families get their own
/// subtype table, so a FinancialTransfer cannot reference SWAP/BURN by mistake.
model FinancialTransferAction {
  id          String             @id @default(uuid()) @db.Uuid
  flowId      String             @db.Uuid
  operationId String             @db.Uuid
  operation   FinancialOperation @relation(fields: [operationId, flowId], references: [id, flowId], onDelete: Restrict, onUpdate: NoAction)
  transfer    FinancialTransfer?
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)

  @@unique([id, flowId])
}
