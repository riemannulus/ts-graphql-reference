// Prisma schema — https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider     = "prisma-pothos-types"
  // Emit a .ts file (not the default type-only .d.ts) so it includes the
  // runtime getDatamodel() that Pothos requires on Prisma 7.
  output       = "../src/generated/pothos-types.ts"
  clientOutput = "@prisma/client"
}

datasource db {
  provider = "postgresql"
}

/// A user of the system. `status` is a state machine (see user.state.ts):
/// ACTIVE | SUSPENDED | DEACTIVATED. The *transition rules* live in code (the
/// single source of truth, user.state.ts); the *value set* is additionally
/// enforced by a DB CHECK constraint (see the migrations), so a corrupt write
/// fails at the database instead of surfacing later as a bad read.
model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  name         String?
  status       String        @default("ACTIVE")
  posts        Post[]
  pointBalance PointBalance?
  pointCharges PointCharge[]
  pointSpends  PointSpend[]
  sessions     Session[]
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  published Boolean  @default(false)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([authorId])
}

/// Denormalized point balance per user — the snapshot the spend use-case
/// decides against. Kept consistent with the charge ledger inside the same
/// transaction that mutates it (see point.repo.ts).
model PointBalance {
  userId      Int      @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidAmount  Int      @default(0)
  freeAmount  Int      @default(0)
  totalAmount Int      @default(0)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
}

/// One charge (top-up) of points. `state` is USABLE | CONSUMED | EXPIRED,
/// enforced by a DB CHECK constraint; the unspent columns carry non-negative
/// CHECKs so an overdraft can never be persisted even by buggy application code.
/// A charge EXPIRES at the end of the KST day `EXPIRE_AFTER_DAYS` after
/// `chargedAt` (the rule lives in point.core.ts `planExpiry`); `expiredAt` is
/// stamped by that decision (the plan's `now`), never a DB default — see
/// CONVENTIONS §10 "Time".
model PointCharge {
  id                Int       @id @default(autoincrement())
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  state             String    @default("USABLE")
  paidAmount        Int
  freeAmount        Int
  unspentPaidAmount Int
  unspentFreeAmount Int
  /// When the charge happened. Stamped by the charge use-case from the app clock
  /// (planCharge carries it) because the expiry decision reads it back against
  /// `now` — CONVENTIONS §10. `@default(now())` stays only as a backstop for a
  /// raw insert that bypasses the use-case.
  chargedAt         DateTime  @default(now()) @db.Timestamptz(6)
  /// When this charge was expired (its remainder swept to zero); NULL until then.
  /// A domain timestamp, written by the expiry use-case, not `@default(now())`.
  expiredAt         DateTime? @db.Timestamptz(6)

  @@index([userId, state, chargedAt])
}

/// A feature flag — the crepe model: a flag is ACTIVE only for a specific deploy
/// `stage`, inside its `[enableAfter, disableAfter]` window, and while not
/// soft-deleted. `name` is the OpenFeature flag key; the DB-backed OpenFeature
/// provider (src/modules/feature-flag/feature-flag.provider.ts) reads the one
/// LIVE row per name. The activation rule lives in code (feature-flag.core.ts
/// `isActive`, single source of truth); the `stage` value set and the window
/// ordering are additionally backed by DB CHECK constraints (see the migration),
/// and one-live-row-per-name by a partial unique index — so a name is reusable
/// after a soft delete (crepe recreate-by-name).
model FeatureFlag {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  /// Deploy environment this flag applies to (value set backed by a CHECK, like
  /// User.status — never a Prisma enum). A NULL-stage row can never be active.
  stage        String?
  /// Optional payload for a non-boolean flag: the variant/value an ACTIVE flag
  /// resolves to (e.g. the welcome-post variant). NULL for a plain on/off gate.
  /// This extends the crepe model, which is boolean-only, so the DB provider can
  /// back OpenFeature string/variant resolution over the same table.
  value        String?
  enableAfter  DateTime? @db.Timestamptz(6)
  disableAfter DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  @@index([name])
}

/// One spend of points, recording how it split across paid and free balance.
model PointSpend {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidAmount  Int
  freeAmount  Int
  totalAmount Int
  reason      String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
}

/// An authenticated session — the principal seam (design spec §10.1).
/// `accessToken` is the opaque credential a caller presents (cookie →
/// `Authorization: Bearer` → `connectionParams`, parsed by `auth.value.ts`); its
/// UNIQUE index makes one-row-per-token a DATABASE fact, so a duplicate mint
/// fails at the constraint (concurrency ladder rung 1, CONVENTIONS §1) instead of
/// resolving two principals. Whether a session is still valid is decided in code
/// against the injected clock (`auth.service.resolvePrincipal`) — the row stores
/// the instant, it never judges it. Dropping the user cascades the sessions away.
model Session {
  id          String   @id @default(uuid())
  accessToken String   @unique
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Audit-only: when the session was minted. NO decision reads it (CONVENTIONS
  /// §10 rule 2) — `expiresAt` is the decision-relevant instant, so this column
  /// may keep its DB-clock default without straddling the two clocks.
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  /// When the session stops resolving to a principal. A DOMAIN timestamp, hence
  /// NO `@default`: the session-minting use-case stamps it from the injected
  /// `Clock` (CONVENTIONS §10 rule 1), so the expiry comparison is single-clocked
  /// and a fixed test clock can pin it.
  expiresAt   DateTime @db.Timestamptz(6)

  @@index([userId])
}

/// The transactional outbox — a row is enqueued in the SAME transaction as the
/// domain write and published by the drainer after commit (delivery ladder rung 1,
/// design spec §4.3). Payloads carry IDS ONLY, which is what makes duplicate
/// delivery and reordering harmless. Claiming is `FOR UPDATE SKIP LOCKED` (the
/// concurrency ladder's rung 4) over `OutboxEvent_pending_idx`, a PARTIAL index
/// Prisma cannot express — SQL-only, exactly like `FeatureFlag_name_live_key`.
/// This is the ONLY `BigInt` and the ONLY `Json` in this schema: a JS `bigint`
/// makes `JSON.stringify` THROW, so `src/events/outbox.repo.ts` maps `id` to
/// `string` at its boundary and no `bigint` escapes that one file.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  topic       String
  /// The topic key normalized to TEXT. Read back through the topic's
  /// `TopicSpec.keyKind` (`src/events/event-registry.ts`), so a numeric key is a
  /// `number` again by the time a subscriber sees it.
  key         String
  /// The event body — ids only. NON-nullable on purpose: a Prisma `Json?` has TWO
  /// nulls (`Prisma.DbNull` vs `Prisma.JsonNull`) and Prisma 7 rejects a bare
  /// `null`, so an empty body is written as `{}` and that ambiguity never exists.
  payload     Json
  /// Audit-only: when the row was enqueued. NO decision reads it (CONVENTIONS §10
  /// rule 2); the drainer orders by `id`, never by this column.
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  /// Stamped from the app clock when the event reached the bus (CONVENTIONS §10
  /// rule 1); NULL means still pending, which is half of the partial index's
  /// predicate.
  publishedAt DateTime? @db.Timestamptz(6)
  /// Delivery attempts so far. A DB CHECK keeps it non-negative — the direct
  /// analogue of `PointBalance_paidAmount_check`.
  attempts    Int       @default(0)
  /// Retries exhausted (the DLQ stamp, app clock again): the row leaves the claim
  /// set — the other half of the partial index's predicate — and waits for an
  /// operator instead of blocking the queue.
  failedAt    DateTime? @db.Timestamptz(6)
}
